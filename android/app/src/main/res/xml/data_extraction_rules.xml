<?xml version="1.0" encoding="utf-8"?>
<!--
  Excludes all app data (the SQLite database and every ID photo under app-private
  storage) from Android's cloud backup and device-to-device transfer. Guest data
  never leaves this device except through an explicit, PIN-less local .zip export.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="false">
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
