{
  "name": "hotel-customer-manager",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "description": "Offline-first hotel customer management app (React + Vite + Capacitor + SQLite)",
  "scripts": {
    "predev": "node scripts/copy-sql-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-sql-wasm.mjs --clean",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "cap:sync": "npm run build && cap sync android",
    "android:add": "cap add android",
    "android:run": "npm run cap:sync && cap run android",
    "android:apk": "npm run cap:sync && node scripts/android.mjs assembleDebug",
    "android:release": "npm run cap:sync && node scripts/android.mjs assembleRelease",
    "android:clean": "node scripts/android.mjs clean",
    "release": "npm run verify && npm run android:release"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "fflate": "^0.8.2",
    "jeep-sqlite": "^2.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "sql.js": "^1.13.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
